{
  "name": "@myloop/cli",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=26.4.0"
  },
  "type": "module",
  "bin": {
    "myloop": "./dist/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && chmod +x dist/main.js",

{
  "name": "mycoder",
  "version": "1.0.0",
  "description": "",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && tsc && npm run build --workspace @mycoder/app-sdk && npm run build --workspace apps/cli && npm run build --workspace packages/pty && npm run build --workspace apps/tui",
    "typecheck": "tsc --noEmit && npm run build --workspace @mycoder/app-sdk && npm run typecheck --workspace packages/pty && npm run typecheck --workspace apps/cli && npm run typecheck --workspace apps/tui",
    "test": "vitest run && npm run test --workspace @mycoder/app-sdk && npm run test --workspace packages/pty && npm run test --workspace apps/cli && npm run test --workspace apps/tui",
    "cli": "npm run build --workspace apps/cli && node apps/cli/dist/main.js",
    "tui": "npm run build && node --experimental-ffi apps/tui/dist/main.js",
    "prepublishOnly": "npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./agent": {
      "types": "./dist/agent/index.d.ts",
      "default": "./dist/agent/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./messages": {
      "types": "./dist/runtime/messages.d.ts",
      "default": "./dist/runtime/messages.js"
    },
    "./command": {
      "types": "./dist/command/index.d.ts",
      "default": "./dist/command/index.js"
    },
    "./command/shell": {
      "types": "./dist/command/shell/index.d.ts",
      "default": "./dist/command/shell/index.js"
    },
    "./clients/anthropic": {
      "types": "./dist/clients/anthropic.d.ts",
      "default": "./dist/clients/anthropic.js"
    },
    "./clients/openai-chat": {
      "types": "./dist/clients/openai-chat.d.ts",
      "default": "./dist/clients/openai-chat.js"
    },
    "./clients/openai-responses": {
      "types": "./dist/clients/openai-responses.d.ts",
      "default": "./dist/clients/openai-responses.js"
    },
    "./skills": {
      "types": "./dist/skills/index.d.ts",
      "default": "./dist/skills/index.js"
    },
    "./config": {
      "types": "./dist/config.d.ts",
      "default": "./dist/config.js"
    },
    "./composite": {
      "types": "./dist/agent/composite.d.ts",
      "default": "./dist/agent/composite.js"
    },
    "./session": {
      "types": "./dist/agent/session.d.ts",
      "default": "./dist/agent/session.js"
    },
    "./agent/context": {
      "types": "./dist/runtime/context.d.ts",
      "default": "./dist/runtime/context.js"
    },
    "./runtime/context": {
      "types": "./dist/runtime/context.d.ts",
      "default": "./dist/runtime/context.js"
    },
    "./package.json": "./package.json"
  },
  "allowScripts": {
    "node-pty@1.1.0": true
  },
  "config": {},
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^3.2.7"
  }
}
